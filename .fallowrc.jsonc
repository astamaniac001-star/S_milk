// Fallow config — https://fallow.tools/docs/configuration/
//
// Goals:
//   1. Dead code (unused files/exports) is a hard gate — it must never grow.
//   2. Complexity is REPORTED but advisory until the refactors in the
//      2026-11-27 plan land; promote complexity-* to "error" afterwards.
//   3. Generated artifacts are excluded from clone detection, never edited.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // `src/main.jsx` is already detected as an entry point via package.json /
  // the Vite plugin, so no explicit `entry` list is needed.
  // Dev-only tooling that runs outside production.
  "supportEntry": [
    "scripts/**",
    "e2e/**",
    "vite.config.js",
    "playwright.config.js",
    "eslint.config.js",
  ],

  // Generated by `npm run db:sync` — must never be hand-edited, and its
  // table-shape repetition is not real duplication.
  "duplicates": {
    "ignore": ["src/lib/database.types.ts"],
  },

  // Test/config code is not product code: keep it out of the maintainability
  // score and out of complexity findings (describe() blocks are huge by design).
  "health": {
    "ignore": [
      "**/*.test.js",
      "**/*.test.jsx",
      "e2e/**",
      "scripts/**",
      "src/test/**",
      "vite.config.js",
      "playwright.config.js",
      "eslint.config.js",
    ],
  },

  // Dead code gates CI; complexity reports only (see file header).
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-dependencies": "error",
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn",
    "complexity-file-lines": "warn",
  },
}
